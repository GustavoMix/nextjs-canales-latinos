# En local no hace falta configurar nada: usa public/data.
# En GitHub Pages tampoco: detecta automáticamente:
# https://TU-USUARIO.github.io/channelwatch-cron/data

# Solo usa esta variable si alojas los JSON en otra URL (por ejemplo Vercel + otro dominio):
# NEXT_PUBLIC_CHANNELWATCH_DATA_URL=https://datos.example.com/data

# GitHub Actions define NEXT_PUBLIC_BASE_PATH automáticamente durante el build.
# Para una exportación manual bajo un subdirectorio puedes usar, por ejemplo:
# NEXT_PUBLIC_BASE_PATH=/tv-latino-web
